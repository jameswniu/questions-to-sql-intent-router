# Copy to .env to change how the app reaches Claude. Everything else runs without it.

# none answers from retrieval and SQL alone; anthropic calls the API directly; vertex goes through Google Cloud.
CLAUDE_BACKEND=none

# Used when CLAUDE_BACKEND=anthropic.
ANTHROPIC_API_KEY=

# Used when CLAUDE_BACKEND=vertex, with application default credentials available to the container.
VERTEX_PROJECT=
VERTEX_REGION=us-east5

# Host port for the web app, if 8000 is taken.
# APP_PORT=8000

# Date the data is read as of. Leave unset to use as_of from data/policy.yaml.
# AS_OF=2026-07-15
