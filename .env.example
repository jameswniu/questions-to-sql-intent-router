# Copy to .env to change how the app reaches Claude or learns who is asking. Everything else runs without it.

# demo lets anyone pick a user from data/users.yaml and serves on loopback only. header takes the user from
# X-Auth-Request-User, set by a sign-in proxy such as oauth2-proxy, and is what the app uses when this is unset.
# In header mode the proxy must also set X-Auth-Proxy-Secret to AUTH_PROXY_SECRET on every request, and must strip
# any X-Auth-* headers the client sent. The app refuses to start in header mode without AUTH_PROXY_SECRET.
IDENTITY_MODE=demo

# Used when IDENTITY_MODE=header: a long random value shared with the sign-in proxy and nothing else.
AUTH_PROXY_SECRET=

# off, or unset, answers from retrieval and SQL alone. anthropic calls the Anthropic API directly, and vertex goes
# through Google Cloud. Either adds Claude where the rules give up; start it with make up-live and check it with
# make live-check.
LLM_BACKEND=off

# Used when LLM_BACKEND=anthropic.
ANTHROPIC_API_KEY=

# Used when LLM_BACKEND=vertex, with application default credentials in ~/.config/gcloud, which make up-live mounts.
# global is the only region where these models answered.
VERTEX_PROJECT_ID=
VERTEX_REGION=global

# The models live mode calls. The fast one routes, extracts and checks; the main one plans, analyzes and writes.
# LIVE_FAST_MODEL=claude-haiku-4-5
# LIVE_MAIN_MODEL=claude-sonnet-5

# Where the support check runs. It reads each cited sentence of a written answer against the passage it cites.
# same, or unset, keeps it on the fast model above. gemini runs it on Gemini through Vertex AI, signed in with the
# same application default credentials, and is the one to pick: a checker from another model family is independent
# of the writer. anthropic or vertex runs it on Claude through that backend, set up as above.
# LLM_CHECK_BACKEND=gemini

# Used when LLM_CHECK_BACKEND=gemini. The project defaults to VERTEX_PROJECT_ID, and the location to global.
# GEMINI_PROJECT=
# GEMINI_LOCATION=global

# The checker's model when LLM_CHECK_BACKEND names a backend. Unset, it is gemini-3.8-flash for gemini and
# claude-haiku-4-5 for anthropic or vertex.
# LIVE_CHECK_MODEL=gemini-3.8-flash

# Host port for the web app, if 8000 is taken.
# APP_PORT=8000

# Date the data is read as of. Leave unset to use as_of from data/policy.yaml.
# AS_OF=2026-07-15
