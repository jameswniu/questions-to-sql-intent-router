# Copy to .env to change how the app reaches Claude or learns who is asking. Everything else runs without it.

# demo lets anyone pick a user from data/users.yaml and serves on loopback only. header takes the user from
# X-Auth-Request-User, set by a sign-in proxy such as oauth2-proxy, and is what the app uses when this is unset.
# In header mode the proxy must also set X-Auth-Proxy-Secret to AUTH_PROXY_SECRET on every request, and must strip
# any X-Auth-* headers the client sent. The app refuses to start in header mode without AUTH_PROXY_SECRET.
IDENTITY_MODE=demo

# Used when IDENTITY_MODE=header: a long random value shared with the sign-in proxy and nothing else.
AUTH_PROXY_SECRET=

# none answers from retrieval and SQL alone; anthropic calls the API directly; vertex goes through Google Cloud.
CLAUDE_BACKEND=none

# Used when CLAUDE_BACKEND=anthropic.
ANTHROPIC_API_KEY=

# Used when CLAUDE_BACKEND=vertex, with application default credentials available to the container.
VERTEX_PROJECT=
VERTEX_REGION=us-east5

# Host port for the web app, if 8000 is taken.
# APP_PORT=8000

# Date the data is read as of. Leave unset to use as_of from data/policy.yaml.
# AS_OF=2026-07-15
